{
  "name": "next-js-docker-backend",
  "version": "1.0.0",
  "description": "Express backend for the next-js-docker example, backed by DynamoDB Local (in-memory) instead of AWS",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --require @opentelemetry/auto-instrumentations-node/register dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1109.0",
    "@aws-sdk/lib-dynamodb": "^3.1109.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@trace0/otel-logger": "^1.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
