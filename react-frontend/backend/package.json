{
  "name": "react-frontend-backend",
  "version": "1.0.0",
  "description": "Tiny Express API that the React frontend calls, to demonstrate frontend-to-backend trace linking",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --require @opentelemetry/auto-instrumentations-node/register dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "express": "^5.3.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
